#%PAM-1.0
# gdm-smartcard-sssd-exclusive with GNOME keyring unlock (mfa-keyring).
#
# Installed as the highest-priority alternative for /etc/pam.d/gdm-smartcard.
# Differences from gdm-smartcard-sssd-exclusive:
#   - pam_sss gets forward_pass so the verified PIN is available as PAM_AUTHTOK
#   - pam_mfa_keyring (straight after pam_sss) uses that PIN to unwrap the
#     secret on the card and replaces PAM_AUTHTOK with it, or clears it so the
#     PIN never reaches pam_gnome_keyring
#   - pam_zfs_key then sees the secret, for users whose encrypted ZFS home is
#     keyed to it (mfa-keyring zfs-enroll)
#   - the root check runs after authentication instead of first.  GDM starts
#     this service without a username so that pam_sss can identify the user
#     from the card; pam_succeed_if would ask for a username first.
auth    [success=ok module_unknown=3 default=die] pam_sss.so allow_missing_name require_cert_auth forward_pass
# The next three lines only run after pam_sss verified the card and PIN.  A
# password must never get here: it would be sent to the card as a PIN.
auth    [success=ok default=1] pam_mfa_keyring.so mode=piv
# PAM_AUTHTOK is cleared when authentication ends, so pam_zfs_key must pick
# the secret up now to mount an encrypted ZFS home in the session.  Skipped
# unless the secret was recovered, so it can't prompt for a password.
auth    optional        pam_zfs_key.so
# Skip the password fallback below.
auth    [default=2]     pam_permit.so
# If SSSD is not installed or configured, we still fallback to default auth
auth    optional        pam_echo.so SSSD PAM module is not installed, Smart card authentication is not supported, falling back to default mechanism
auth    substack        common-auth
auth    [success=ok user_unknown=ignore default=bad] pam_succeed_if.so user != root quiet_success

auth    requisite       pam_nologin.so
auth    optional        pam_gnome_keyring.so

@include common-account
# SELinux needs to be the first session rule. This ensures that any
# lingering context has been cleared. Without this it is possible
# that a module could execute code in the wrong domain.
session [success=ok ignore=ignore module_unknown=ignore default=bad]        pam_selinux.so close
session required        pam_loginuid.so
# SELinux needs to intervene at login time to ensure that the process
# starts in the proper default security context. Only sessions which are
# intended to run in the user's context should be run after this.
# pam_selinux.so changes the SELinux context of the used TTY and configures
# SELinux in order to transition to the user context with the next execve()
# call.
session [success=ok ignore=ignore module_unknown=ignore default=bad]        pam_selinux.so open
session optional        pam_keyinit.so force revoke
session required        pam_limits.so
session required        pam_env.so readenv=1
session required        pam_env.so readenv=1 user_readenv=1 envfile=/etc/default/locale
@include common-session
session optional        pam_gnome_keyring.so auto_start
